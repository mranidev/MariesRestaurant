{
    "name": "pasta/ti-theme-maries",
    "type": "tastyigniter-package",
    "description": "Restaurant theme for Maries, an Italian restaurant in Tunis, Tunisia.",
    "license": "MIT",
    "authors": [
        {
            "name": "Aouinti Ahmed"
        }
    ],
    "keywords": [
        "tastyigniter",
        "theme",
        "restaurant",
        "pasta"
    ],
    "require": {
        "php": "^8.3",
        "tastyigniter/core": "^4.0",
        "tastyigniter/ti-ext-local": "*",
        "tastyigniter/ti-ext-cart": "*"
    },
    "extra": {
        "tastyigniter-theme": {
            "code": "maries",
            "name": "Maries",
            "locked": false,
            "source-path": "/resources/views",
            "meta-path": "/resources/meta",
            "publish-paths": [
                "/public"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
